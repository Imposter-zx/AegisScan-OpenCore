# AegisScan Strategic v4.0 Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
AEGISCAN_API_SECRET=change-this-to-a-random-secret-key
AEGISCAN_API_HOST=0.0.0.0
AEGISCAN_API_PORT=5000
AEGISCAN_API_DEBUG=false

# Security
AEGISCAN_ADMIN_USERNAME=admin
AEGISCAN_ADMIN_PASSWORD=change-this-password

# NVD API (for live CVE correlation)
AEGISCAN_API_KEY=

# Network
AEGISCAN_DEFAULT_TIMEOUT=30
AEGISCAN_MAX_CONCURRENT=3

# Reporting
AEGISCAN_REPORT_DIR=reports
AEGISCAN_LOG_LEVEL=INFO

# Integrations
AEGISCAN_WEBHOOK_URL=
AEGISCAN_WEBHOOK_TOKEN=
AEGISCAN_SPLUNK_HEC_URL=
AEGISCAN_SPLUNK_HEC_TOKEN=
AEGISCAN_ELASTICSEARCH_HOSTS=localhost:9200